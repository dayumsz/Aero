local function RebuildHooks()
	if type(hookmetamethod) ~= "function" or type(newcclosure) ~= "function" or type(getnamecallmethod) ~= "function" then
		return false
	end
	if not RayHook.Base then
		local Cap
		local Ok = pcall(function()
			Cap = hookmetamethod(game, "__namecall", newcclosure(function(Self, ...)
				return Cap(Self, ...)
			end))
		end)
		if not Ok or not Cap then return false end
		RayHook.Base = Cap
	end
	local Ok = pcall(function()
		hookmetamethod(game, "__namecall", RayHook.Base)
		RayHook.Fn = nil; FallHook.Fn = nil
		if RayHook.On then
			local Old = RayHook.Base
			RayHook.Fn = newcclosure(function(Self, ...)
				if Noclip.On and Alive and getnamecallmethod() == "Raycast" then return nil end
				return Old(Self, ...)
			end)
			hookmetamethod(game, "__namecall", RayHook.Fn)
		end
		if FallHook.On then
			local Old = RayHook.On and RayHook.Fn or RayHook.Base
			FallHook.Fn = newcclosure(function(Self, ...)
				if not Rem.NoFall or not Alive then return Old(Self, ...) end
				local M = getnamecallmethod()
				if M == "FireServer" and typeof(Self) == "Instance" then
					local A = {...}
					if type(A[1]) == "number" and type(A[2]) == "boolean" and A[1] > 2 and A[2] == false then return end
				end
				return Old(Self, ...)
			end)
			hookmetamethod(game, "__namecall", FallHook.Fn)
		end
	end)
	return Ok
end

local function InstallRayHook()
	if RayHook.On then return end
	if type(hookmetamethod) ~= "function" then return end
	RayHook.On = true
	if not RebuildHooks() then RayHook.On = false; RebuildHooks() end
end

local function RemoveRayHook()
	if not RayHook.On then return end
	RayHook.On = false; RebuildHooks()
end

local function InstallFallHook()
	if FallHook.On then return end
