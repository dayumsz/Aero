local function SpectateRestoreCamera()
	pcall(function()
		Spectate.Camera = workspace.CurrentCamera
		if LP.Character and LP.Character:FindFirstChild("Humanoid") then
			Spectate.Camera.CameraSubject = LP.Character.Humanoid
		end
		pcall(function() LP:RemoveTag("ForcedSubject") end)
	end)
end

local function SpectateApplySubject()
	if not Spectate.Current or not Spectate.On then
		SpectateRestoreCamera()
		return
	end
	local TargChar = Spectate.Current.Character
	if not TargChar then
		SpectateRestoreCamera()
		return
	end
	local Hum = TargChar:FindFirstChild("Humanoid")
	if not Hum then
		SpectateRestoreCamera()
		return
	end
	pcall(function()
		Spectate.Camera = workspace.CurrentCamera
		Spectate.Camera.CameraSubject = Hum
		pcall(function() LP:AddTag("ForcedSubject") end)
	end)
end

local function SpectateDisconnectInternal()
	if Spectate.StreamConn then Spectate.StreamConn:Disconnect(); Spectate.StreamConn = nil end
	if Spectate.SubjectConn then Spectate.SubjectConn:Disconnect(); Spectate.SubjectConn = nil end
	if Spectate.CharConn then Spectate.CharConn:Disconnect(); Spectate.CharConn = nil end
end

local function SpectateSetTarget(TargetPlayer)
	SpectateDisconnectInternal()
	if not TargetPlayer or not Spectate.On then
		Spectate.Current = nil
		SpectateRestoreCamera()
		return
	end
	if TargetPlayer == LP then
		Spectate.Current = nil
		SpectateRestoreCamera()
		return
	end
	Spectate.Current = TargetPlayer
	SpectateApplySubject()
	Spectate.StreamConn = Services.RunService.Heartbeat:Connect(function()
		if not Alive or not Spectate.On or not Spectate.Current then return end
		pcall(function()
			local TargChar = Spectate.Current.Character
			if not TargChar then return end
			local Root = TargChar:FindFirstChild("HumanoidRootPart")
			if not Root then return end
			LP:RequestStreamAroundAsync(Root.Position, 0.1)
		end)
	end)
	Spectate.SubjectConn = Services.RunService.RenderStepped:Connect(function()
		if not Alive or not Spectate.On or not Spectate.Current then return end
		pcall(function()
			local TargChar = Spectate.Current.Character
			if not TargChar then return end
			local Hum = TargChar:FindFirstChild("Humanoid")
			if not Hum then return end
			local Cam = workspace.CurrentCamera
			if Cam.CameraSubject ~= Hum then
				Cam.CameraSubject = Hum
			end
		end)
	end)
	Spectate.CharConn = TargetPlayer.CharacterAdded:Connect(function(NewChar)
		if not Alive or not Spectate.On or Spectate.Current ~= TargetPlayer then return end
		task.wait(0.5)
		if not Alive or not Spectate.On or Spectate.Current ~= TargetPlayer then return end
		SpectateApplySubject()
	end)
end

local function SpectateConnectFrame(Frame)
	if Spectate.ConnectedFrames[Frame] then return end
	local PlayerLabel = Frame:FindFirstChild("Player")
	if not PlayerLabel then return end
	local Conn = Frame.InputBegan:Connect(function(Input)
		if not Spectate.On or not Alive then return end
		if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then return end
		local RawText = PlayerLabel.Text
		local TargetName = RawText:match("^%s*(.-)%s*%(") or RawText:match("^%s*(.-)%s*$")
		local TargetPlayer = Services.Players:FindFirstChild(TargetName)
		if TargetPlayer and TargetPlayer ~= LP then
			if Spectate.Current == TargetPlayer then
				SpectateSetTarget(nil)
			else
				SpectateSetTarget(TargetPlayer)
			end
		end
	end)
	Spectate.ConnectedFrames[Frame] = Conn
end

local function SpectateHookScrollingFrame(ScrollingFrame)
	for _, Child in ipairs(ScrollingFrame:GetChildren()) do
		local PF = Child:FindFirstChild("PlayerFrame")
		if PF then SpectateConnectFrame(PF) end
	end
	ScrollingFrame.ChildAdded:Connect(function(Child)
		local PF = Child:FindFirstChild("PlayerFrame")
		if PF then
			SpectateConnectFrame(PF)
		else
			Child.ChildAdded:Connect(function(Sub)
				if Sub.Name == "PlayerFrame" then SpectateConnectFrame(Sub) end
			end)
		end
	end)
end

