local function WaitChar(Char)
	for _ = 1, 50 do
		local HRP = Char:FindFirstChild("HumanoidRootPart")
		local Head = Char:FindFirstChild("Head")
		local Hum = Char:FindFirstChildOfClass("Humanoid")
		if HRP and Head and Hum and HRP.Parent == Char and Head.Parent == Char then return true end
		task.wait(0.1)
	end
	return false
end

local function ApplyAllEsp(Player, Char)
	if not Esp.On or Player == LP then return end
	if not Char or not Char.Parent then return end
	MakeLabelBill(Player, Char)
	if Esp.Box     then MakeBoxBill(Player, Char) end
	if Esp.HPBar   then MakeHPBar(Player, Char) end
	if Esp.StomBar then MakeStomBar(Player, Char) end
	if Esp.WatBar  then MakeWatBar(Player, Char) end
	if Esp.EthBar  then MakeEthBar(Player, Char) end
	if Esp.PostBar then MakePostBar(Player, Char) end
	if Esp.BldBar  then MakeBldBar(Player, Char) end
	if Esp.ArmBar  then MakeArmBar(Player, Char) end
	if Esp.SanBar  then MakeSanBar(Player, Char) end
	RecalcBars(Player)
end

local function SetupPlayerEsp(Player)
	if Player == LP then return end
	Esp.Players[Player] = Esp.Players[Player] or {}
	local PD = Esp.Players[Player]
	if PD.CharConn then pcall(function() PD.CharConn:Disconnect() end); PD.CharConn = nil end
	PD.CharConn = Player.CharacterAdded:Connect(function(Char)
		task.spawn(function()
			if not Alive or not Esp.On then return end
			if not WaitChar(Char) then return end
			if not Alive or not Esp.On or Player.Character ~= Char then return end
			ApplyAllEsp(Player, Char)
		end)
	end)
	if Player.Character then
		local Char = Player.Character
		task.spawn(function()
			if not Alive or not Esp.On then return end
			if not WaitChar(Char) then return end
			if not Alive or not Esp.On or Player.Character ~= Char then return end
			ApplyAllEsp(Player, Char)
		end)
	end
	pcall(function()
		Player:GetAttributeChangedSignal("Guild"):Connect(function()
			Esp.GuildCache[Player] = nil
		end)
	end)
end

local function IsValidMob(Model)
	if not Model or not Model.Parent then return false end
	if not Model:IsA("Model") then return false end
	if not Model:FindFirstChildOfClass("Humanoid") then return false end
	if Model == LP.Character then return false end
	if Services.Players:GetPlayerFromCharacter(Model) then return false end
	if Model:FindFirstChild("InteractPrompt") then return false end
	local Live = workspace:FindFirstChild("Live")
	if not Live or Model.Parent ~= Live then return false end
	return true
end

local function GetMobRoot(Model)
	return Model:FindFirstChild("Head") or Model:FindFirstChild("HumanoidRootPart")
end

local function RemoveMob(Model)
	local D = MobEsp.Data[Model]
	if not D then return end
	if D.Bill then pcall(function() D.Bill:Destroy() end) end
	if D.HL   then pcall(function() D.HL:Destroy() end) end
	MobEsp.Data[Model] = nil
end

local function MakeMobBill(Model)
	if not IsValidMob(Model) then return end
	local Root = GetMobRoot(Model)
	if not Root then return end
	local D = MobEsp.Data[Model]
	if D and D.Bill and D.Bill.Parent == Root then return end
	if D then RemoveMob(Model) end
	local BG = Instance.new("BillboardGui")
	BG.Name = "MobESP"; BG.Adornee = Root
	BG.StudsOffset = Vector3.new(0,2.5,0)
	BG.AlwaysOnTop = true; BG.ResetOnSpawn = false
	BG.Size = UDim2.new(0,120,0,60); BG.Parent = Root
	local Lbl = Instance.new("TextLabel")
	Lbl.Size = UDim2.new(1.5,0,1.5,0); Lbl.BackgroundTransparency = 1
	Lbl.TextColor3 = MobEsp.Color; Lbl.TextStrokeTransparency = 0
	Lbl.TextStrokeColor3 = Color3.fromRGB(0,0,0)
	Lbl.Font = Enum.Font.Ubuntu; Lbl.TextScaled = false
	Lbl.TextSize = 12; Lbl.Text = ""; Lbl.Parent = BG
	local HL = nil
	if MobEsp.Hl then
		pcall(function()
			HL = Instance.new("Highlight")
			HL.FillColor = MobEsp.Color; HL.OutlineColor = MobEsp.Color
			HL.FillTransparency = 0.5; HL.OutlineTransparency = 0
			HL.DepthMode = Enum.HighlightDepthMode.Occluded
			HL.Adornee = Model; HL.Parent = Model
		end)
	end
	MobEsp.Data[Model] = {
		Bill    = BG, Lbl = Lbl, HL = HL,
		LastTxt = "", LastVis = nil,
		Name    = Model.Name:gsub("^%.", ""):gsub("%d+$", ""),
		Hum     = Model:FindFirstChildOfClass("Humanoid"),
	}
end

local function TryAddMob(Model)
	if MobEsp.Data[Model] or not IsValidMob(Model) then return end
	local Root = GetMobRoot(Model)
	if Root then
		MakeMobBill(Model)
	else
		task.spawn(function()
			local Deadline = tick() + 30
			while tick() < Deadline do
				task.wait(0.2)
				Root = GetMobRoot(Model)
				if Root then break end
			end
			if not Root or not IsValidMob(Model) or MobEsp.Data[Model] then return end
			MakeMobBill(Model)
		end)
	end
end

local function ClearMobEsp()
	for M in pairs(MobEsp.Data) do RemoveMob(M) end
	MobEsp.Data = {}
end

local function EnableMobEsp()
	if not Alive then return end
	MobEsp.On = true
	local Live = GetLive()
	if Live then
		for _, C in ipairs(Live:GetChildren()) do TryAddMob(C) end
		if MobEsp.AddConn then MobEsp.AddConn:Disconnect() end
		if MobEsp.RemConn then MobEsp.RemConn:Disconnect() end
		MobEsp.AddConn = Live.ChildAdded:Connect(function(C)
			if MobEsp.On then task.wait(0.15); TryAddMob(C) end
		end)
		MobEsp.RemConn = Live.ChildRemoved:Connect(RemoveMob)
	end
	if Conns.Mob then Conns.Mob:Disconnect() end
	Conns.Mob = Services.RunService.Heartbeat:Connect(function()
		if not Alive or not MobEsp.On then return end
		local Now = tick()
		if Now - LastTick.Mob < Rates.Mob then return end
		LastTick.Mob = Now
		local MR = LP.Character and GetRoot(LP.Character)
		if not MR then return end
		local MP = MR.Position
		local Cam = workspace.CurrentCamera
		for Model, D in pairs(MobEsp.Data) do
			pcall(function()
				if not IsValidMob(Model) then
					RemoveMob(Model)
				else
					local Root = GetMobRoot(Model)
					local Hum = D.Hum
					if not Hum or not Hum.Parent then
						Hum = Model:FindFirstChildOfClass("Humanoid"); D.Hum = Hum
					end
					if Root and Hum and Hum.Health > 0 then
						local Dist = (MP - Root.Position).Magnitude
						local Vis = Dist <= MobEsp.MaxDist
						if Vis then local _, OnSc = Cam:WorldToViewportPoint(Root.Position); Vis = OnSc end
						if D.LastVis ~= Vis then
							D.LastVis = Vis
							if D.Bill then D.Bill.Enabled = Vis end
							if D.HL   then D.HL.Enabled   = Vis end
						end
						if Vis then
							local NT = string.format("%s\n(%d studs)\n[%d/%d]",
								D.Name, math.floor(Dist+0.5),
								math.floor(Hum.Health+0.5), math.floor(Hum.MaxHealth+0.5))
							if NT ~= D.LastTxt then
								D.Lbl.Text = NT; D.Lbl.TextColor3 = MobEsp.Color; D.LastTxt = NT
							end
						end
					else
						if D.LastVis ~= false then
							D.LastVis = false
							if D.Bill then D.Bill.Enabled = false end
							if D.HL   then D.HL.Enabled   = false end
						end
					end
				end
			end)
		end
	end)
end

