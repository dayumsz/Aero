local ChestColor = Color3.fromRGB(255,128,192)

local function GetChestPart(Obj)
	if Obj:IsA("Model")    then return Obj.PrimaryPart or Obj:FindFirstChildWhichIsA("BasePart") end
	if Obj:IsA("BasePart") then return Obj end
end

local function RemoveChest(Obj)
	local D = ChestEsp.Data[Obj]
	if not D then return end
	if D.Bill then pcall(function() D.Bill:Destroy() end) end
	ChestEsp.Data[Obj] = nil
end

local function MakeChestBill(Obj)
	if ChestEsp.Opened[Obj] or ChestEsp.Data[Obj] then return end
	local Part = GetChestPart(Obj)
	if not Part then return end
	local BG = Instance.new("BillboardGui")
	BG.Name = "ChestESP"; BG.Adornee = Part
	BG.StudsOffset = Vector3.new(0,3,0); BG.AlwaysOnTop = true
	BG.ResetOnSpawn = false; BG.Size = UDim2.new(0,140,0,50); BG.Parent = Part
	local Lbl = Instance.new("TextLabel")
	Lbl.Name = "ChestLabel"; Lbl.Size = UDim2.new(1.5,0,1.5,0)
	Lbl.BackgroundTransparency = 1; Lbl.TextColor3 = ChestColor
	Lbl.TextStrokeTransparency = 0; Lbl.TextStrokeColor3 = Color3.fromRGB(0,0,0)
	Lbl.Font = Enum.Font.Ubuntu; Lbl.TextScaled = false
	Lbl.TextSize = 12; Lbl.Text = "Loot"; Lbl.Parent = BG
	ChestEsp.Data[Obj] = {Bill = BG, Lbl = Lbl, Part = Part, LastTxt = ""}
end

local function TryAddChest(Obj)
	if not Obj or not Obj:IsA("Model") or Obj.Name ~= "Model" then return end
	task.defer(function()
		task.wait(0.1)
		if Obj and Obj.Parent and not ChestEsp.Opened[Obj] then MakeChestBill(Obj) end
	end)
end

local function RunChestLoop()
	if Conns.Chest then Conns.Chest:Disconnect() end
	Conns.Chest = Services.RunService.Heartbeat:Connect(function()
		if not Alive or not ChestEsp.On then return end
		local Now = tick()
		if Now - LastTick.Chest < Rates.Chest then return end
		LastTick.Chest = Now
		local MR = LP.Character and GetRoot(LP.Character)
		if not MR then return end
		local MP  = MR.Position
		local Cam = workspace.CurrentCamera
		for Obj, D in pairs(ChestEsp.Data) do
			pcall(function()
				if not D.Part or not D.Part.Parent or not Obj.Parent then
					RemoveChest(Obj)
				else
					local Dist = (MP - D.Part.Position).Magnitude
					if Dist <= 25 then
						ChestEsp.Opened[Obj] = true; RemoveChest(Obj)
					elseif Dist > ChestEsp.MaxDist then
						if D.Bill.Enabled then D.Bill.Enabled = false end
					else
						local _, OnSc = Cam:WorldToViewportPoint(D.Part.Position)
						if D.Bill.Enabled ~= OnSc then D.Bill.Enabled = OnSc end
						if OnSc then
							local NT = string.format("Loot\n(%d studs)", math.floor(Dist+0.5))
							if NT ~= D.LastTxt then D.Lbl.Text = NT; D.LastTxt = NT end
						end
					end
				end
			end)
		end
	end)
end

local function SetupChestConns(Thrown)
	if ChestEsp.AddConn then ChestEsp.AddConn:Disconnect() end
	if ChestEsp.RemConn then ChestEsp.RemConn:Disconnect() end
	ChestEsp.AddConn = Thrown.ChildAdded:Connect(function(C)
		if ChestEsp.On then task.wait(0.15); TryAddChest(C) end
	end)
	ChestEsp.RemConn = Thrown.ChildRemoved:Connect(RemoveChest)
end

local function EnableChestEsp()
	if not Alive then return end
	ChestEsp.On = true
	local Thrown = workspace:FindFirstChild("Thrown")
	if not Thrown then
		task.spawn(function()
			local Deadline = tick() + 30
			while tick() < Deadline do
				task.wait(0.5)
				Thrown = workspace:FindFirstChild("Thrown")
				if Thrown then break end
			end
			if not Thrown or not ChestEsp.On then return end
			for _, C in ipairs(Thrown:GetChildren()) do TryAddChest(C) end
			SetupChestConns(Thrown); RunChestLoop()
		end)
		return
	end
	for _, C in ipairs(Thrown:GetChildren()) do TryAddChest(C) end
	SetupChestConns(Thrown); RunChestLoop()
end

local function DisableChestEsp()
	ChestEsp.On = false
	if Conns.Chest        then Conns.Chest:Disconnect();        Conns.Chest = nil end
	if ChestEsp.AddConn   then ChestEsp.AddConn:Disconnect();   ChestEsp.AddConn = nil end
	if ChestEsp.RemConn   then ChestEsp.RemConn:Disconnect();   ChestEsp.RemConn = nil end
	for Obj in pairs(ChestEsp.Data) do RemoveChest(Obj) end
	ChestEsp.Data = {}; ChestEsp.Opened = {}
end

local function UpdateEsp()
	if not Alive or not Esp.On then return end
	local Now = tick()
	if Now - LastTick.Esp < Rates.Esp then return end
	LastTick.Esp = Now
	local MyChar = LP.Character
	local MyRoot = MyChar and GetRoot(MyChar)
	if not MyRoot then return end
	local MyPos    = MyRoot.Position
	local Cam      = workspace.CurrentCamera
	local MaxDistSq = Esp.MaxDist * Esp.MaxDist
	local Live     = workspace:FindFirstChild("Live")
	for Player, PD in pairs(Esp.Players) do
		if Player ~= LP then
			pcall(function()
				local Char = Player.Character
				if not Char then
					SetAllEnabled(PD, false)
				else
					local Root = Char:FindFirstChild("HumanoidRootPart") or Char:FindFirstChild("Head")
					local Hum  = Char:FindFirstChildOfClass("Humanoid")
					if not Root or not Hum then
						SetAllEnabled(PD, false)
						if not PD.WaitingChar then
							PD.WaitingChar = true
							task.spawn(function()
								if not WaitChar(Char) then PD.WaitingChar = nil; return end
								if Alive and Esp.On and Player.Character == Char then ApplyAllEsp(Player, Char) end
								PD.WaitingChar = nil
							end)
						end
					else
						PD.WaitingChar = nil
						local LblRoot = Char:FindFirstChild("Head") or Root
						if not PD.Bill or PD.Bill.Parent ~= LblRoot then MakeLabelBill(Player, Char); PD = Esp.Players[Player]; if not PD then return end end
						if Esp.Box     and (not PD.BoxBill  or PD.BoxBill.Parent  ~= Root) then MakeBoxBill(Player, Char);  PD = Esp.Players[Player]; if not PD then return end end
						if Esp.HPBar   and (not PD.BarBill  or PD.BarBill.Parent  ~= Root) then MakeHPBar(Player, Char);    PD = Esp.Players[Player]; if not PD then return end end
						if Esp.StomBar and (not PD.StomBill or PD.StomBill.Parent ~= Root) then MakeStomBar(Player, Char);  PD = Esp.Players[Player]; if not PD then return end end
						if Esp.WatBar  and (not PD.WatBill  or PD.WatBill.Parent  ~= Root) then MakeWatBar(Player, Char);   PD = Esp.Players[Player]; if not PD then return end end
						if Esp.EthBar  and (not PD.EthBill  or PD.EthBill.Parent  ~= Root) then MakeEthBar(Player, Char);   PD = Esp.Players[Player]; if not PD then return end end
						if Esp.PostBar and (not PD.PostBill or PD.PostBill.Parent ~= Root) then MakePostBar(Player, Char);  PD = Esp.Players[Player]; if not PD then return end end
						if Esp.BldBar  and (not PD.BldBill  or PD.BldBill.Parent  ~= Root) then MakeBldBar(Player, Char);   PD = Esp.Players[Player]; if not PD then return end end
						if Esp.ArmBar  and (not PD.ArmBill  or PD.ArmBill.Parent  ~= Root) then MakeArmBar(Player, Char);   PD = Esp.Players[Player]; if not PD then return end end
						if Esp.SanBar  and (not PD.SanBill  or PD.SanBill.Parent  ~= Root) then MakeSanBar(Player, Char);   PD = Esp.Players[Player]; if not PD then return end end
						PD = Esp.Players[Player]
						if not PD then return end
						local RPos = Root.Position
						local DX, DY, DZ = RPos.X-MyPos.X, RPos.Y-MyPos.Y, RPos.Z-MyPos.Z
						local DistSq = DX*DX + DY*DY + DZ*DZ
						local Dist   = math.sqrt(DistSq)
						local Vis    = false
						if DistSq <= MaxDistSq and Cam then
							local _, OnSc = Cam:WorldToViewportPoint(RPos); Vis = OnSc
						end
						local LC = Live and Live:FindFirstChild(Player.Name)
						if PD.Bill and PD.Lbl then
							if not Vis then
								if PD.Bill.Enabled then PD.Bill.Enabled = false end
							else
								if not PD.Bill.Enabled then PD.Bill.Enabled = true end
								PD.Lbl.TextColor3 = Esp.Color
								local Parts = {}
								if Esp.Name  then Parts[#Parts+1] = Player.Name end
								if Esp.Level then
									local Lvl; pcall(function() Lvl = Char:GetAttribute("Level") or Player:GetAttribute("Level") end)
									if Lvl ~= nil then Parts[#Parts+1] = "[Level "..tostring(Lvl).."]" end
								end
								if Esp.Guild then
									local G = Player:GetAttribute("Guild")
									if typeof(G) == "string" and G ~= "" then Parts[#Parts+1] = "Guild: "..G end
								end
								if Esp.Dist then Parts[#Parts+1] = "("..math.floor(Dist+0.5).." studs)" end
								if Esp.HP   then
									local HP = 0
									pcall(function()
										if Hum.MaxHealth > 0 then HP = math.floor(math.clamp(Hum.Health/Hum.MaxHealth,0,1)*100+0.5) end
									end)
									Parts[#Parts+1] = "["..HP.."%]"
								end
								local NT = table.concat(Parts, "\n")
								if NT ~= PD.LastTxt then PD.Lbl.Text = NT; PD.LastTxt = NT end
							end
						end
						if PD.BoxBill then
							local Should = Esp.Box and Vis
							if PD.BoxBill.Enabled ~= Should then PD.BoxBill.Enabled = Should end
						end
						if PD.BarBill and PD.BarSegs then
							if not Esp.HPBar or not Vis then
								if PD.BarBill.Enabled then PD.BarBill.Enabled = false end
							else
								if not PD.BarBill.Enabled then PD.BarBill.Enabled = true end
								pcall(function()
									if Hum.MaxHealth > 0 then
										local HR = math.clamp(Hum.Health/Hum.MaxHealth,0,1)
										if math.abs(HR - (PD.LastHPR or -1)) > 0.005 then
											PD.LastHPR = HR
											UpdateSegs(PD.BarSegs, HR, Color3.new(math.clamp(2*(1-HR),0,1), math.clamp(2*HR,0,1), 0))
										end
									end
								end)
							end
						end
						local function UpdateVBar(BillKey, SegsKey, LastKey, ValName, Enabled, HiC, LoC)
							local Bill = PD[BillKey]; local Segs = PD[SegsKey]
							if not Bill or not Segs then return end
							if not Enabled or not Vis then if Bill.Enabled then Bill.Enabled = false end; return end
							if not Bill.Enabled then Bill.Enabled = true end
							local Ratio = 1
							local V = FindVal(Char, LC, ValName)
							if V then Ratio = SafeRatio(V) end
							if math.abs(Ratio - (PD[LastKey] or -1)) > 0.005 then
								PD[LastKey] = Ratio
								UpdateSegs(Segs, Ratio, Color3.new(
									LoC.R+(HiC.R-LoC.R)*Ratio, LoC.G+(HiC.G-LoC.G)*Ratio, LoC.B+(HiC.B-LoC.B)*Ratio))
							end
						end
						UpdateVBar("StomBill","StomSegs","LastStomR","Stomach", Esp.StomBar, Color3.fromRGB(210,180,50),  Color3.fromRGB(180,80,20))
						UpdateVBar("WatBill", "WatSegs", "LastWatR", "Water",   Esp.WatBar,  Color3.fromRGB(50,150,255),  Color3.fromRGB(20,80,200))
						UpdateVBar("EthBill", "EthSegs", "LastEthR", "Ether",   Esp.EthBar,  Color3.fromRGB(100,220,255), Color3.fromRGB(50,180,230))
						local function UpdateHBar(BillKey, SegsKey, LastKey, ValName, Enabled, HiC, LoC)
							local Bill = PD[BillKey]; local Segs = PD[SegsKey]
							if not Bill or not Segs then return end
							if not Enabled or not Vis then if Bill.Enabled then Bill.Enabled = false end; return end
							if not Bill.Enabled then Bill.Enabled = true end
							local Ratio = 0
							local V = FindVal(Char, LC, ValName)
							if V then Ratio = SafeRatio(V) end
							if math.abs(Ratio - (PD[LastKey] or -1)) > 0.005 then
								PD[LastKey] = Ratio
								UpdateSegsH(Segs, Ratio, Color3.new(
									LoC.R+(HiC.R-LoC.R)*Ratio, LoC.G+(HiC.G-LoC.G)*Ratio, LoC.B+(HiC.B-LoC.B)*Ratio))
							end
						end
						UpdateHBar("PostBill","PostSegs","LastPostR","BreakMeter",Esp.PostBar,Color3.fromRGB(255,210,0),   Color3.fromRGB(190,120,20))
						UpdateHBar("BldBill", "BldSegs", "LastBldR", "Blood",     Esp.BldBar, Color3.fromRGB(240,80,80),   Color3.fromRGB(120,10,10))
						UpdateHBar("ArmBill", "ArmSegs", "LastArmR", "Armor",     Esp.ArmBar, Color3.fromRGB(220,228,236), Color3.fromRGB(120,130,140))
						UpdateHBar("SanBill", "SanSegs", "LastSanR", "Sanity",    Esp.SanBar, Color3.fromRGB(170,90,230),  Color3.fromRGB(90,40,140))
					end
				end
			end)
		end
	end
end

