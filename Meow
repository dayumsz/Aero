Sec.VTit:NewButton("Void Titus", "Void Titus", function()
	local Char = LP.Character; if not Char then return end
	local Root = Char:FindFirstChild("HumanoidRootPart"); if not Root then return end
	local Live = workspace:FindFirstChild("Live"); if not Live then return end
	local Titus
	for _, V in ipairs(Live:GetChildren()) do
		if string.find(string.lower(V.Name), "titus") then Titus = V; break end
	end
	if not Titus then return end
	local TR = Titus:FindFirstChild("HumanoidRootPart"); if not TR then return end
	local WasNoclip = Noclip.On
	if not Noclip.On then
		EnableNoclip()
		if NoclipTog and NoclipTog.Set then pcall(function() NoclipTog:Set(true) end) end
	end
	local BH, BR, SV
	BH = Services.RunService.Heartbeat:Connect(function()
		pcall(function()
			local C = LP.Character; if not C then return end
			local HRP = C:FindFirstChild("HumanoidRootPart"); if not HRP then return end
			SV = HRP.AssemblyLinearVelocity
			HRP.AssemblyLinearVelocity = Vector3.new(0,-9e9,0)
		end)
	end)
	BR = Services.RunService.PreRender:Connect(function()
		if not SV then return end
		pcall(function()
			local C = LP.Character; if not C then return end
			local HRP = C:FindFirstChild("HumanoidRootPart"); if not HRP then return end
			HRP.AssemblyLinearVelocity = SV
		end)
	end)
	task.wait()
	local Tween = Services.TweenService:Create(Root, TweenInfo.new(3, Enum.EasingStyle.Linear), {CFrame = TR.CFrame * CFrame.new(0,-1,0)})
	Tween:Play()
	task.delay(2.55, function()
		pcall(function()
			local VIM = game:GetService("VirtualInputManager")
			VIM:SendKeyEvent(true,  Enum.KeyCode.W, false, game)
			task.wait(0.5)
			VIM:SendKeyEvent(false, Enum.KeyCode.W, false, game)
		end)
	end)
	Tween.Completed:Wait()
	local T0 = tick()
	while tick()-T0 < 1.3 do
		if not TR.Parent then break end
		pcall(function() Root.CFrame = TR.CFrame * CFrame.new(0,-1,0) end)
		Services.RunService.Heartbeat:Wait()
	end
	if BH then BH:Disconnect(); BH = nil end
	if BR then BR:Disconnect(); BR = nil end
	SV = nil
	if not WasNoclip then
		DisableNoclip(); Save:SetValue("noclip_enable", false)
		if NoclipTog and NoclipTog.Set then pcall(function() NoclipTog:Set(false) end) end
	end
end, {Confirm = true, ConfirmMessage = "Are you sure you want to void Titus?"})

