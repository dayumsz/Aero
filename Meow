local function MakeBoxBill(Player, Char)
	if Player == LP then return end
	local Root = Char and Char:FindFirstChild("HumanoidRootPart")
	if not Root then return end
	local PD = Esp.Players[Player]
	if PD and PD.BoxBill then
		if PD.BoxBill.Parent == Root then return end
		pcall(function() PD.BoxBill:Destroy() end); PD.BoxBill = nil
	end
	local BG = MakeBB("PlayerBoxESP", Root, Vector3.new(0,0,0))
	BG.ClipsDescendants = false
	local BF = Instance.new("Frame")
	BF.Size = UDim2.new(1,0,1,0); BF.BackgroundTransparency = 1; BF.BorderSizePixel = 0; BF.Parent = BG
	local function MkLine(Sz, Pos)
		local F = Instance.new("Frame")
		F.Size = Sz; F.Position = Pos
		F.BackgroundColor3 = Color3.fromRGB(255,255,255); F.BorderSizePixel = 0; F.Parent = BF
	end
	MkLine(UDim2.new(1,0,0,1), UDim2.new(0,0,0,0))
	MkLine(UDim2.new(1,0,0,1), UDim2.new(0,0,1,-1))
	MkLine(UDim2.new(0,1,1,0), UDim2.new(0,0,0,0))
	MkLine(UDim2.new(0,1,1,0), UDim2.new(1,-1,0,0))
	BG.Size = UDim2.new(4,0,6,0)
	PD = Esp.Players[Player] or {}; PD.BoxBill = BG; Esp.Players[Player] = PD
end

local function MakeVertBar(Player, Char, FieldName, BillKey, SegsKey, Color, AttrName)
	if Player == LP then return end
	local Root = Char and Char:FindFirstChild("HumanoidRootPart")
	if not Root then return end
	if AttrName then
		local Live = workspace:FindFirstChild("Live")
		local LC = Live and Live:FindFirstChild(Player.Name)
		if not FindVal(Char, LC, AttrName) then return end
	end
	local PD = Esp.Players[Player]
	if PD and PD[BillKey] then
		if PD[BillKey].Parent == Root then return end
		pcall(function() PD[BillKey]:Destroy() end); PD[BillKey] = nil
	end
	local BG = MakeBB(FieldName, Root)
	BG.ClipsDescendants = false; BG.Size = UDim2.new(0.2,0,6,0)
	local MF = Instance.new("Frame")
	MF.Size = UDim2.new(1,0,1,0); MF.BackgroundTransparency = 1; MF.BorderSizePixel = 0; MF.Parent = BG
	local Segs = MakeSegBar(MF, Color)
	PD = Esp.Players[Player] or {}; PD[BillKey] = BG; PD[SegsKey] = Segs
	Esp.Players[Player] = PD; RecalcBars(Player)
end

local function MakeHorizBar(Player, Char, BillKey, SegsKey, Name, Color, SzFn, AttrName)
	if Player == LP then return end
	local Root = Char and Char:FindFirstChild("HumanoidRootPart")
	if not Root then return end
	if AttrName then
		local Live = workspace:FindFirstChild("Live")
		local LC = Live and Live:FindFirstChild(Player.Name)
		if not FindVal(Char, LC, AttrName) then return end
	end
	local PD = Esp.Players[Player]
	if PD and PD[BillKey] then
		if PD[BillKey].Parent == Root then return end
		pcall(function() PD[BillKey]:Destroy() end); PD[BillKey] = nil; PD[SegsKey] = nil
	end
	local BG = MakeBB(Name, Root)
	BG.ClipsDescendants = false
	local MF = Instance.new("Frame")
	MF.Size = UDim2.new(1,0,1,0); MF.BackgroundTransparency = 1; MF.BorderSizePixel = 0; MF.Parent = BG
	local Segs = MakeSegBarH(MF, Color)
	SzFn(BG)
	PD = Esp.Players[Player] or {}; PD[BillKey] = BG; PD[SegsKey] = Segs
	Esp.Players[Player] = PD
end

