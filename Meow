end

local function MakeSegBar(Parent, Color)
	local BC = Instance.new("Frame")
	BC.Size = UDim2.new(1,0,1,0); BC.BackgroundColor3 = Color3.fromRGB(20,20,20)
	BC.BorderSizePixel = 0; BC.ClipsDescendants = false; BC.Parent = Parent
	local Sk = Instance.new("UIStroke")
	Sk.Color = Color3.fromRGB(0,0,0); Sk.Thickness = 1.5
	Sk.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; Sk.Parent = BC
	local Segs, Gap, H = {}, 0.01, (1 - 0.01*4)/5
	for I = 1, 5 do
		local YP = 1 - (I*H) - ((I-1)*Gap)
		local SB = Instance.new("Frame")
		SB.Size = UDim2.new(1,0,H,0); SB.Position = UDim2.new(0,0,YP,0)
		SB.BackgroundColor3 = Color3.fromRGB(40,40,40); SB.BorderSizePixel = 0
		SB.ClipsDescendants = true; SB.Parent = BC
		local FI = Instance.new("Frame")
		FI.Size = UDim2.new(1,0,1,0); FI.BackgroundColor3 = Color; FI.BorderSizePixel = 0; FI.Parent = SB
		Segs[I] = {BG = SB, Fill = FI}
	end
	return Segs
end

local function MakeSegBarH(Parent, Color)
	local BC = Instance.new("Frame")
	BC.Size = UDim2.new(1,0,1,0); BC.BackgroundColor3 = Color3.fromRGB(20,20,20)
	BC.BorderSizePixel = 0; BC.ClipsDescendants = false; BC.Parent = Parent
	local Sk = Instance.new("UIStroke")
	Sk.Color = Color3.fromRGB(0,0,0); Sk.Thickness = 1.5
	Sk.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; Sk.Parent = BC
	local Segs, Gap, W = {}, 0.01, (1 - 0.01*4)/5
	for I = 1, 5 do
		local XP = (I-1)*W + (I-1)*Gap
		local SB = Instance.new("Frame")
		SB.Size = UDim2.new(W,0,1,0); SB.Position = UDim2.new(XP,0,0,0)
		SB.BackgroundColor3 = Color3.fromRGB(40,40,40); SB.BorderSizePixel = 0
		SB.ClipsDescendants = true; SB.Parent = BC
		local FI = Instance.new("Frame")
		FI.Size = UDim2.new(1,0,1,0); FI.BackgroundColor3 = Color; FI.BorderSizePixel = 0; FI.Parent = SB
		Segs[I] = {BG = SB, Fill = FI}
	end
	return Segs
end

local function UpdateSegs(Segs, Ratio, Color)
	if not Segs then return end
	for I = 1, 5 do
		local S = Segs[I]
		if S and S.Fill then
			local FR = math.clamp((Ratio - (I-1)/5) / 0.2, 0, 1)
			S.Fill.BackgroundColor3 = Color
			pcall(function()
				Services.TweenService:Create(S.Fill, BarCfg.SegInfo, {
					Size     = UDim2.new(1,0,FR,0),
					Position = UDim2.new(0,0,1-FR,0),
				}):Play()
			end)
		end
	end
end

local function UpdateSegsH(Segs, Ratio, Color)
	if not Segs then return end
	for I = 1, 5 do
		local S = Segs[I]
		if S and S.Fill then
			local FR = math.clamp((Ratio - (I-1)/5) / 0.2, 0, 1)
			S.Fill.BackgroundColor3 = Color
			pcall(function()
