	if Player == LP or not Char or not Char.Parent then return end
	local Head = Char:FindFirstChild("Head")
	local Root = Head or Char:FindFirstChild("HumanoidRootPart")
	if not Root then return end
	local PD = Esp.Players[Player]
	if PD and PD.Bill then
		if PD.Bill.Parent == Root then return end
		pcall(function() PD.Bill:Destroy() end)
		PD.Bill = nil; PD.Lbl = nil; PD.LastTxt = nil
	end
	local YOff = Head and 2.5 or 3.5
	local BG = Instance.new("BillboardGui")
	BG.Name = "PlayerESP"; BG.Adornee = Root
	BG.StudsOffsetWorldSpace = Vector3.new(0,YOff,0)
	BG.AlwaysOnTop = true; BG.ResetOnSpawn = false; BG.LightInfluence = 0; BG.Parent = Root
	local Lbl = Instance.new("TextLabel")
