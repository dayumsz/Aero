			Lbl.Size = UDim2.new(1,-8,1,0); Lbl.Position = UDim2.new(0,4,0,0)
			Lbl.BackgroundTransparency = 1; Lbl.Font = Enum.Font.SourceSans
			Lbl.TextSize = 12; Lbl.TextColor3 = RowColor
			Lbl.TextXAlignment = Enum.TextXAlignment.Left
			Lbl.TextYAlignment = Enum.TextYAlignment.Center; Lbl.Parent = Row
			if BT then pcall(function() BT(Lbl, {TextColor3 = "TextDim"}) end) end
			local PlayerName = Entry.Name
			if ProxEsp.RowConns[PlayerName] then
				pcall(function() ProxEsp.RowConns[PlayerName]:Disconnect() end)
			end
			ProxEsp.RowConns[PlayerName] = Row.InputBegan:Connect(function(Input)
				if not Spectate.On or not Alive then return end
				if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then return end
				local TargetPlayer = Services.Players:FindFirstChild(PlayerName)
				if TargetPlayer and TargetPlayer ~= LP then
					if Spectate.Current == TargetPlayer then
						SpectateSetTarget(nil)
					else
						SpectateSetTarget(TargetPlayer)
					end
				end
			end)
		end
		local Lbl = Row:FindFirstChildOfClass("TextLabel")
		local IsSpectating = Spectate.On and Spectate.Current and Spectate.Current.Name == Entry.Name
		if Lbl then
			if IsSpectating then
				Lbl.Text = string.format("[>] %s  %d studs", Entry.Name, math.floor(Entry.Dist+0.5))
				Lbl.TextColor3 = Color3.fromRGB(255, 200, 50)
			else
				Lbl.Text = string.format("%s  %d studs", Entry.Name, math.floor(Entry.Dist+0.5))
				Lbl.TextColor3 = RowColor
			end
		end
		Row.LayoutOrder = I
	end
	for Name, Row in pairs(Existing) do
		if not Seen[Name] then
			if ProxEsp.RowConns[Name] then
				pcall(function() ProxEsp.RowConns[Name]:Disconnect() end)
				ProxEsp.RowConns[Name] = nil
			end
			Row:Destroy()
		end
	end
end

