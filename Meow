local function SafeRatio(V)
	if not V then return 1 end
	local Ok1, Min = pcall(function() return V.MinValue end)
	local Ok2, Max = pcall(function() return V.MaxValue end)
	Min = (Ok1 and type(Min) == "number") and Min or 0
	Max = (Ok2 and type(Max) == "number") and Max or 100
	local Ok3, Cur = pcall(function() return V.Value end)
	if not Ok3 or type(Cur) ~= "number" then Cur = 0 end
	local Range = Max - Min
	if Range <= 0 then return 1 end
	return math.clamp((Cur - Min) / Range, 0, 1)
end

