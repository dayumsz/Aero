local function EnableFly()
	if not Alive then return end
	DisableFly(); Fly.On = true
	local Char = LP.Character; if not Char then return end
	local Root = Char:FindFirstChild("HumanoidRootPart")
	local Hum  = Char:FindFirstChildOfClass("Humanoid")
	if not Root or not Hum then return end
	pcall(function() Hum.PlatformStand = true end)
	CreateFlyBV()
	Fly.Conn = Services.RunService.RenderStepped:Connect(function()
		if not Alive or not Fly.On then return end
		if not Fly.BV or not Fly.BV.Parent then CreateFlyBV(); if not Fly.BV then return end end
		local Cam = workspace.CurrentCamera; if not Cam then return end
		local Dir = Vector3.zero
		if Services.InputService:IsKeyDown(Enum.KeyCode.W) then Dir = Dir + Cam.CFrame.LookVector end
		if Services.InputService:IsKeyDown(Enum.KeyCode.S) then Dir = Dir - Cam.CFrame.LookVector end
		if Services.InputService:IsKeyDown(Enum.KeyCode.A) then Dir = Dir - Cam.CFrame.RightVector end
		if Services.InputService:IsKeyDown(Enum.KeyCode.D) then Dir = Dir + Cam.CFrame.RightVector end
		if Services.InputService:IsKeyDown(Enum.KeyCode.Space) then Dir = Dir + Vector3.new(0,1,0) end
		if Services.InputService:IsKeyDown(Enum.KeyCode.LeftControl) or Services.InputService:IsKeyDown(Enum.KeyCode.C) then
			Dir = Dir - Vector3.new(0,1,0)
		end
		if Dir.Magnitude > 0 then
			pcall(function() Fly.BV.Velocity = Dir.Unit * Fly.Speed end)
		else
			pcall(function() Fly.BV.Velocity = Vector3.zero end)
		end
	end)
	Fly.Refresh = task.spawn(function()
		while Alive and Fly.On do task.wait(3); if Alive and Fly.On then CreateFlyBV() end end
	end)
end

local function RestoreWorld()
	for Part, Can in pairs(Noclip.WorldParts) do
		pcall(function() if Part and Part.Parent then Part.CanCollide = Can end end)
	end
	Noclip.WorldParts = {}
end

local function RestoreNoclip()
	if Noclip.Conn then Noclip.Conn:Disconnect(); Noclip.Conn = nil end
	for Part, Can in pairs(Noclip.CharParts) do
		pcall(function() if Part and Part.Parent then Part.CanCollide = Can end end)
	end
	Noclip.CharParts = {}; RestoreWorld()
end

local function ApplyNoclip()
	local Char = LP.Character; if not Char then return end
	for _, Part in ipairs(Char:GetDescendants()) do
		pcall(function()
			if Part:IsA("BasePart") then
				if Noclip.CharParts[Part] == nil then Noclip.CharParts[Part] = Part.CanCollide end
				Part.CanCollide = false
			end
		end)
	end
end

local function UpdateWorldNoclip()
	if not Noclip.On or not Noclip.Full then RestoreWorld(); return end
	local Char = LP.Character; if not Char then return end
	local Root = Char:FindFirstChild("HumanoidRootPart"); if not Root then return end
	local Params = OverlapParams.new()
	Params.FilterType = Enum.RaycastFilterType.Exclude
	Params.FilterDescendantsInstances = {Char}
	local Ok, Nearby = pcall(function() return workspace:GetPartBoundsInRadius(Root.Position, 250, Params) end)
	if not Ok or not Nearby then return end
	local Seen = {}
	for _, Part in ipairs(Nearby) do
		pcall(function()
			if Part:IsA("BasePart") then
				Seen[Part] = true
				if Noclip.WorldParts[Part] == nil then Noclip.WorldParts[Part] = Part.CanCollide end
				Part.CanCollide = false
			end
		end)
	end
	for Part, Can in pairs(Noclip.WorldParts) do
		if not Seen[Part] then
			pcall(function() if Part and Part.Parent then Part.CanCollide = Can end end)
			Noclip.WorldParts[Part] = nil
		end
	end
end

local function EnableNoclip()
	if not Alive then return end
	Noclip.On = true; InstallRayHook(); ApplyNoclip()
	if Noclip.Conn then Noclip.Conn:Disconnect(); Noclip.Conn = nil end
	Noclip.Conn = Services.RunService.Stepped:Connect(function()
		if not Alive or not Noclip.On then return end
		local Char = LP.Character; if not Char then return end
		for _, Part in ipairs(Char:GetDescendants()) do
			pcall(function()
				if Part:IsA("BasePart") then
					if Noclip.CharParts[Part] == nil then Noclip.CharParts[Part] = Part.CanCollide end
					Part.CanCollide = false
				end
			end)
		end
		if Noclip.Full then UpdateWorldNoclip() else RestoreWorld() end
	end)
end

local function DisableNoclip()
	Noclip.On = false; RemoveRayHook(); RestoreNoclip()
end

local function EnableNoFall()
	if not Alive then return end
	if NoFallPending then pcall(function() task.cancel(NoFallPending) end); NoFallPending = nil end
	NoFallPending = task.spawn(function()
		local Char = LP.Character
		if not Char then Char = LP.CharacterAdded:Wait() end
		if not Alive then return end
		local HRP = Char:FindFirstChild("HumanoidRootPart")
		if not HRP then HRP = Char:WaitForChild("HumanoidRootPart", 30) end
		if not HRP or not Alive then return end
		task.wait(3)
		if not Alive then return end
		Rem.NoFall = true
		if not FallHook.On then
			InstallFallHook()
			if not FallHook.On then Rem.NoFall = false end
		end
		NoFallPending = nil
	end)
end

local function DisableNoFall()
	Rem.NoFall = false
	if NoFallPending then pcall(function() task.cancel(NoFallPending) end); NoFallPending = nil end
	RemoveFallHook()
end

local function FullCleanup()
	Alive = false
	_G[SCRIPT_ID .. "_Running"] = nil
	_G[SCRIPT_ID .. "_Notify"] = nil
	_G[SCRIPT_ID .. "_Confirm"] = nil
	_G[SCRIPT_ID .. "_Unload"] = nil
	Noclip.On = false; Fly.On = false; Rem.NoFall = false; Rem.Chat = false
	pcall(RemoveRayHook)
	if Conns.Input          then Conns.Input:Disconnect();          Conns.Input = nil end
	if Noclip.Conn          then Noclip.Conn:Disconnect();          Noclip.Conn = nil end
	if Fly.Conn             then Fly.Conn:Disconnect();             Fly.Conn = nil end
	if Conns.Esp            then Conns.Esp:Disconnect();            Conns.Esp = nil end
	if Noclip.CharConn      then Noclip.CharConn:Disconnect();      Noclip.CharConn = nil end
	if Conns.PlayerAdded    then Conns.PlayerAdded:Disconnect();    Conns.PlayerAdded = nil end
	if Conns.PlayerRemoving then Conns.PlayerRemoving:Disconnect(); Conns.PlayerRemoving = nil end
	if NoFallPending        then pcall(function() task.cancel(NoFallPending) end); NoFallPending = nil end
	pcall(DisableFly); pcall(DisableNoclip); pcall(DisableNoFall)
	pcall(DisableNoFog); pcall(DisableMobEsp); pcall(DisableEsp)
	pcall(DisableChestEsp); pcall(DisableProxEsp); pcall(StopVMob)
	pcall(DisableSpectate); pcall(StopAllLoops)
	pcall(function()
		local CWC = Services.TCS.ChatWindowConfiguration
		if CWC then CWC.Enabled = false end
	end)
	Esp.On = false; ClearEsp()
	pcall(function() task.cancel(ClientLoop) end)
end

