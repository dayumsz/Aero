local function RecalcBars(Player)
	local PD = Esp.Players[Player]
	if not PD then return end
	local RI, LI = 0, 0
	local Slots = {
		{BB = PD.BarBill,  En = Esp.On and Esp.HPBar,  Side = "right"},
		{BB = PD.StomBill, En = Esp.On and Esp.StomBar, Side = "left"},
		{BB = PD.WatBill,  En = Esp.On and Esp.WatBar,  Side = "left"},
		{BB = PD.EthBill,  En = Esp.On and Esp.EthBar,  Side = "right"},
	}
	for _, SL in ipairs(Slots) do
		if SL.En and SL.BB then
			if SL.Side == "right" then
				RI = RI + 1
				SL.BB.StudsOffset = Vector3.new(2.3 + (RI-1)*(BarCfg.Width+BarCfg.Gap), 0, 0)
			else
				LI = LI + 1
				SL.BB.StudsOffset = Vector3.new(-(2.3 + (LI-1)*(BarCfg.Width+BarCfg.Gap)), 0, 0)
			end
		end
	end
end

